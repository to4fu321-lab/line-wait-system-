# ============================================================
# Supabase 設定
# Supabase > Settings > API からコピーしてください
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxx

# ============================================================
# LINE 制服販売店アカウント（uniform）
# LINE Developers > 制服販売チャンネル
# ============================================================
NEXT_PUBLIC_LIFF_ID_UNIFORM=2xxxxxxxxx-xxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN_UNIFORM=your_uniform_channel_access_token_here
LINE_CHANNEL_SECRET_UNIFORM=your_uniform_channel_secret_here

# ============================================================
# LINE テイクアウト専門店アカウント（takeout）
# LINE Developers > テイクアウトチャンネル
# ============================================================
NEXT_PUBLIC_LIFF_ID_TAKEOUT=2xxxxxxxxx-yyyyyyyy
LINE_CHANNEL_ACCESS_TOKEN_TAKEOUT=your_takeout_channel_access_token_here
LINE_CHANNEL_SECRET_TAKEOUT=your_takeout_channel_secret_here

# ============================================================
# 後方互換：上の _UNIFORM / _TAKEOUT が未設定の場合のフォールバック
# ============================================================
# NEXT_PUBLIC_LIFF_ID=2010126882-aUahQStD
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 開発中に LINE 通知を止めて月間通数を節約する場合は true に設定
# LINE_NOTIFY_DISABLED=true

# ============================================================
# Twilio SMS（LINE未連携顧客へのSMS通知）
# https://console.twilio.com/ から取得
# TWILIO_FROM_NUMBER は E.164形式（例: +815012345678）または
# Alphanumeric Sender ID（例: HimonoPay）
# ============================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+815012345678

# ============================================================
# Anthropic API（受付票OCR自動入力）
# https://console.anthropic.com/ から取得
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Stripe（有料プランへのアップグレード決済）
#   未設定でもアプリは動く（/admin/billing はお問い合わせ導線にフォールバック）。
#   有料プランは Lite/Standard/Pro の3ティア構成。STRIPE_PRICE_<TIER> が
#   設定されているティアだけが /admin/billing に「販売中」として表示される
#   （3つとも設定必須ではない。1つだけでも動く）。
#
#   セットアップ手順:
#   1. https://dashboard.stripe.com/products で商品・価格(Price)を作成し、
#      各ティアの Price ID を STRIPE_PRICE_LITE / _STANDARD / _PRO に設定
#   2. 各ティアの契約成立時に stores.features._plan へ入れたいプランキー
#      （lib/features.ts の Plan 型のいずれか）を STRIPE_PLAN_LITE / _STANDARD /
#      _PRO に設定。省略した場合は 'standard' 扱いになる
#   3. https://dashboard.stripe.com/apikeys のシークレットキーを
#      STRIPE_SECRET_KEY に設定（本番は sk_live_、テストは sk_test_。
#      まずはサンドボックス/テストモードのキーで動作確認すること）
#   4. https://dashboard.stripe.com/webhooks でエンドポイント
#      `https://<デプロイ先ドメイン>/api/webhook/stripe` を追加し、
#      checkout.session.completed / customer.subscription.updated /
#      customer.subscription.deleted を購読。作成後の signing secret を
#      STRIPE_WEBHOOK_SECRET に設定
# ============================================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

STRIPE_PRICE_LITE=your_stripe_price_id_for_lite_here
STRIPE_PLAN_LITE=simple

STRIPE_PRICE_STANDARD=your_stripe_price_id_for_standard_here
STRIPE_PLAN_STANDARD=standard

STRIPE_PRICE_PRO=your_stripe_price_id_for_pro_here
STRIPE_PLAN_PRO=full

# ============================================================
# 管理画面 PIN（デフォルト: 1234）
# ============================================================
NEXT_PUBLIC_ADMIN_PIN=1234

# ============================================================
# 総管理ダッシュボード認証
# NEXT_PUBLIC_ は絶対に付けないこと（クライアントJSバンドルに露出する）
# ============================================================

# /api/super-admin/* へのリクエストを検証するサーバー専用トークン
# 推奨: openssl rand -hex 32 などで生成した64文字以上のランダム文字列
SUPER_ADMIN_SECRET=replace_with_long_random_secret_never_expose_to_client

# 総管理画面のPIN（4桁以上を推奨）
# NEXT_PUBLIC_ を付けずにサーバー側のみで照合する
SUPER_ADMIN_PIN=9999

# ============================================================
# フィードバック → GitHub Issue 自動作成（任意）
#   設定すると、アプリ内フィードバック投稿時に Issue を自動作成する。
#   未設定でもフィードバック自体は保存される（Issue作成のみスキップ）。
#   トークンは Issues 書き込み権限のある PAT（NEXT_PUBLIC_ は付けない）。
# ============================================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=to4fu321-lab/line-wait-system-
